# Talepet local environment template
# Copy to .env for local backend usage. Do not commit real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Auth
JWT_SECRET=<replace-with-strong-jwt-secret>
SIGNUP_TOKEN_SECRET=<replace-with-strong-signup-token-secret>

# Public URLs / CORS
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001/api
APP_BASE_URL=http://localhost:5173
APP_SURFACE_URL=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5173/admin
MARKETING_SITE_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173/admin
VITE_ENABLE_SW=false
VITE_PREMIUM_PURCHASES_ENABLED=false
VITE_RFQ_ANALYTICS_OVERLAY=false

# SMS / OTP
SMS_PROVIDER=iletimerkezi
ILETIMERKEZI_API_KEY=<iletimerkezi-api-key>
ILETIMERKEZI_API_HASH=<iletimerkezi-api-hash>
ILETIMERKEZI_SENDER=<approved-sender>
ILETIMERKEZI_BASE_URL=https://api.iletimerkezi.com
ILETIMERKEZI_IYS=0
SMS_SEND_TIMEOUT_MS=15000
SEND_OTP_TIMEOUT_MS=8000
OTP_TTL_SECONDS=300
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email
EMAIL_PROVIDER=brevo
DRY_RUN=false
MAIL_FROM=Talepet <noreply@example.com>
EMAIL_FROM=Talepet <noreply@example.com>
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=<brevo-smtp-user>
BREVO_SMTP_PASS=<brevo-smtp-password>
BREVO_API_KEY=<brevo-api-key>
SENDGRID_API_KEY=<sendgrid-api-key>
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=8000
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Apple OAuth
APPLE_CLIENT_ID=<apple-client-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY=<apple-private-key-with-escaped-newlines>
APPLE_CALLBACK_URL=http://localhost:3001/api/auth/apple/callback
APPLE_REDIRECT_URI=http://localhost:3001/api/auth/apple/callback

# Iyzico payments
IYZICO_API_KEY=<iyzico-api-key>
IYZICO_SECRET_KEY=<iyzico-secret-key>
IYZICO_WEBHOOK_SECRET=<iyzico-webhook-secret>
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# OneSignal push notifications
ONESIGNAL_APP_ID=<onesignal-app-id>
ONESIGNAL_REST_API_KEY=<onesignal-rest-api-key>
ONESIGNAL_API_URL=https://onesignal.com/api/v1/notifications

# Location / geocoding
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODE_UA=talepet-local/1.0

# Admin utilities
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=<admin-seed-password>
ADMIN_RESET_EMAIL=admin@example.com
ADMIN_RESET_PASSWORD=<temporary-admin-password>
ADMIN_RESET_CONFIRM=false
ADMIN_DASHBOARD_SUMMARY_REFRESH_MS=300000
ADMIN_DASHBOARD_SUMMARY_TTL_MS=60000
REVIEWER_STANDARD_PASSWORD=<reviewer-standard-password>
REVIEWER_PREMIUM_PASSWORD=<reviewer-premium-password>

# Render keepalive job
RENDER_KEEPALIVE_URL=<render-keepalive-url>

# Optional desktop agent / local assistant tooling
OPENAI_API_KEY=<openai-api-key>
JARVIS_OPENAI_API_KEY=<openai-api-key>
JARVIS_VSCODE_PATH=<path-to-vscode>
JARVIS_CHROME_PATH=<path-to-chrome>
JARVIS_APP_NAME=Talepet Assistant
JARVIS_DEFAULT_MODE=ask
JARVIS_ALLOWED_DOMAINS=localhost,127.0.0.1
JARVIS_ALLOWED_FOLDERS=/path/to/allowed/folder
JARVIS_ALLOWED_APPS=code,chrome
JARVIS_ALLOWED_COMMANDS=npm,node,git
JARVIS_ENABLE_VOICE_STUB=false
JARVIS_ENABLE_WAKE_WORD=false
JARVIS_STT_PROVIDER=mock
JARVIS_STT_BASE_URL=http://localhost:8000
JARVIS_STT_MODEL=<stt-model>
JARVIS_STT_LANGUAGE=tr
JARVIS_STT_TIMEOUT_MS=30000
ELECTRON_RENDERER_URL=http://localhost:5174
ELECTRON_DISABLE_SECURITY_WARNINGS=true
